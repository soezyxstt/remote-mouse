{
  "name": "remote-mouse-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:pwa": "npm run dev --workspace=@remote/pwa",
    "dev:desktop": "npm run dev --workspace=@remote/desktop",
    "build": "npm run build --workspaces --if-present",
    "deploy:pwa": "wrangler pages deploy apps/pwa/dist --project-name=remote-mouse-pwa",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "wrangler": "^4.127.1"
  }
}
